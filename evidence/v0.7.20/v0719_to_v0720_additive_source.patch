+class _Handler(socketserver.StreamRequestHandler):
+    def handle(self):
+        try:
+            raw=self.rfile.readline(MAX_FRAME+1)
+            if not raw.endswith(b'\n') or len(raw)>MAX_FRAME:raise ValueError('invalid frame')
+            msg=unique_json(raw.strip())
