cff-version: 1.2.0
title: "Equal3 — research prototype for authenticated local state with external witnesses"
message: "If you use this material, please cite it as below and state its research NO-GO status."
type: software
version: "0.7.22-research"
date-released: 2026-10-26
license: Apache-2.0
